# Supabase (publiques par conception, protégées par la RLS)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# IA — clé gratuite sur https://aistudio.google.com/apikey (côté serveur uniquement)
GEMINI_API_KEY=
# Optionnel : modèle Gemini (par défaut gemini-flash-latest)
GEMINI_MODEL=

# Optionnel : clé secrète Supabase (sb_secret_...) pour effacer les fichiers purgés
SUPABASE_SECRET_KEY=

# Rappels par email (Brevo, SMTP) — nécessitent aussi SUPABASE_SECRET_KEY
BREVO_SMTP_LOGIN=
BREVO_SMTP_KEY=
# Expéditeur validé dans Brevo, par exemple : Regulya <adresse@exemple.fr>
MAIL_FROM=

# Paiement Stripe (laisser vide tant que le compte Stripe n'est pas créé)
# VITE_PAYMENTS_ENABLED=true affiche les boutons de paiement dans l'appli
VITE_PAYMENTS_ENABLED=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Identifiants des prix créés dans Stripe : 2,99 €/mois, 14,99 €/6 mois, 24,99 €/an
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_SEMESTER=
STRIPE_PRICE_ANNUAL=

# Notifications sur le téléphone (Web Push). Générer une paire avec : npx web-push generate-vapid-keys
VITE_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contact@regulya.fr
